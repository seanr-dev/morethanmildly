---
import Layout from '../layouts/Layout.astro';
Astro.response.status = 404;
---

<Layout title="Page not found" noindex
  ><div class="container empty-state not-found">
    <span class="eyebrow">404 · A WRONG TURN</span><h1>
      Curiosity takes you places.<br />Just not this one.
    </h1><p>
      This page may have moved, or its story hasn’t been written yet.
    </p><a href="/" class="button">Back to the journal</a>
  </div></Layout
>
