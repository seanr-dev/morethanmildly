PUBLIC_SITE_URL=https://morethanmildly.netlify.app
# The included admin-host project proxies to the primary application and its database.
PUBLIC_ADMIN_ORIGIN=https://morethanmildly-admin.netlify.app
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_TIKTOK_PIXEL_ID=
# Keep disabled until audience/age and advertising privacy requirements are reviewed.
PUBLIC_MARKETING_ENABLED=false
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://morethanmildly.netlify.app/about
# Random server-only secret. Required for signed visitor IDs and request rate limits.
VISITOR_SECRET=
PUSH_JOB_SECRET=
# Netlify Database injects its own connection automatically. Optional local override:
DATABASE_URL=
# Local QA only: never enable in a production deploy.
LOCAL_DATABASE_URL=
